{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Entra.VerifiedID.Client": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",
  "AppSettings": {
    "CacheExpiresInSeconds": 300
  },

  "EEID": {
    "TenantName": "<...yourname....onmicrosoft.com>",
    "TenantId": "<...guid...>",
    "Authority": "<https://...yourname....ciamlogin.com/>",
    "ClientId": "<your-clientid-of-your-ciam-app>",
    "ClientSecret": "<clientsecret-of-the-above-app>",
    "ResponseType": "code",
    "UsePkce": true,
    "MapInboundClaims": false,
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "VerifiedID": {
    "client_name": "Northwind Airlines",
    "Purpose": "To prove your membership",
    "DidAuthority": "<did:web:...your-name>",
    "CredentialType": "NorthstarLoyalty",
    "CredentialManifest": "https://verifiedid.did.msidentity.com/v1.0/tenants/...your-manifest-URL",
    "PhotoClaimName": "photo",
    "Credentials": [],
    "Verification": {
      "AccountBindingClaim": "email",
      "AccountBindingSource": "email",
      "ProfileValueClaim": "loyalty"
    }
  },
  "IdentityVerification": {
    "PublicBaseUrl": "https://your-public-app.example/",
    "ProviderUrl": "https://trueidentityincv2.azurewebsites.net/",
    "IdentityIssuer": "did:web:did.woodgrovedemo.com",
    "CallbackApiKey": ""
  }

}
